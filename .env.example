# Copy this file to .env in the repository root:  cp .env.example .env
# The real .env file is ignored by Git. Never commit it.

# --- Backend ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- PostgreSQL (read by docker-compose.yml) ---
POSTGRES_USER=stayease_dev
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=stayease_dev

# Not used by the application in Phase 1. Phase 2 (Prisma) will add the
# password to this URL, because PostgreSQL in Docker requires one.
DATABASE_URL=postgresql://stayease_dev@localhost:5432/stayease_dev

# --- Frontend (VITE_ variables are public: never put secrets here) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
